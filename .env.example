# ---------------------------------------------------------------------------
# Microserviço de OCR/XLS — copie para `.env` e preencha. NUNCA commite o .env.
# ---------------------------------------------------------------------------

# API da Anthropic (Claude) — visão/extração
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5

# Regras de negócio
CONFIANCA_MINIMA=0.85          # abaixo disso a linha sai marcada p/ revisão
RETENCAO_DIAS=7               # dias até limpar /data automaticamente
MAX_TENTATIVAS_OCR=3         # re-tentativas de extração se o JSON vier inválido

# Autorização: só este número é processado (formato só dígitos, com DDI+DDD)
ADMIN_WHATSAPP=

# Segredo compartilhado entre o n8n e este microserviço.
# O n8n envia no header `x-microservico-token`. Deixe vazio para desativar (dev).
MICROSERVICO_TOKEN=

# Infra
DATA_DIR=./data
PORT=3000
LOG_LEVEL=info
