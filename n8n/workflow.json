{
  "name": "Lista de Presença - OCR (uazapi + microserviço)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lista-presenca",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook uazapi",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "webhookId": "lista-presenca"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload da uazapi (v2.1.8). O telefone real está em sender_pn\n// (o 'sender' costuma vir como @lid, id de privacidade). A imagem NÃO vem no\n// webhook — pegamos o messageid p/ baixar depois (POST /message/download).\nconst raiz = $input.first().json;\nconst b = raiz.body || raiz;\nconst m = b.message || {};\n\nconst soDigitos = (s) => String(s || '').replace(/\\D/g, '');\nconst numeroDe = (jid) => soDigitos(String(jid || '').split('@')[0]);\n\nconst isGroup = Boolean(m.isGroup) || String(m.chatid || '').includes('@g.us');\nconst remetente = numeroDe(m.sender_pn) || (!isGroup ? numeroDe(m.chatid) : '') || numeroDe(m.sender);\nconst grupo = isGroup ? (m.chatid || '') : '';\nconst fromMe = Boolean(m.fromMe);\n\nconst tipoRaw = m.messageType || m.type || '';\nconst mimeMsg = (m.content && m.content.mimetype) || '';\nconst isImagem = m.mediaType === 'image' || /image/i.test(String(tipoRaw)) || mimeMsg.startsWith('image/');\n\nconst mime = mimeMsg || 'image/jpeg';\nconst messageid = m.messageid || m.id || '';\n\nreturn [{ json: { remetente, grupo, fromMe, messageType: isImagem ? 'image' : String(tipoRaw), mime, messageid } }];\n"
      },
      "id": "normalizar",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "microservicoUrl",
              "type": "string",
              "value": "http://lista-presenca-ocr:3000/processar"
            },
            {
              "id": "a2",
              "name": "microservicoToken",
              "type": "string",
              "value": "COLOQUE_O_MICROSERVICO_TOKEN"
            },
            {
              "id": "a3",
              "name": "uazapiUrl",
              "type": "string",
              "value": "https://SUA-INSTANCIA.uazapi.com"
            },
            {
              "id": "a4",
              "name": "uazapiToken",
              "type": "string",
              "value": "COLOQUE_O_TOKEN_DA_INSTANCIA"
            },
            {
              "id": "a5",
              "name": "adminPrivado",
              "type": "string",
              "value": "5511999998888"
            }
          ]
        }
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.fromMe }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.messageType }}",
              "rightValue": "image",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.remetente }}",
              "rightValue": "={{ $json.adminPrivado }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "ehImagem",
      "name": "É imagem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.uazapiUrl }}/message/download",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $(\"Config\").item.json.uazapiToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.messageid }) }}",
        "options": {}
      },
      "id": "baixarMidia",
      "name": "Baixar mídia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.microservicoUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-microservico-token",
              "value": "={{ $(\"Config\").item.json.microservicoToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ imagem_url: $json.fileURL, mime: $json.mimetype, remetente: $(\"Normalizar\").item.json.remetente, grupo: $(\"Normalizar\").item.json.grupo }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "processar",
      "name": "Processar (microserviço)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ok1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "deuCerto",
      "name": "Deu certo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1280,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.uazapiUrl }}/send/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $(\"Config\").item.json.uazapiToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $(\"Config\").item.json.adminPrivado, type: \"document\", file: $json.xlsx_base64, docName: $json.nome_arquivo, text: \"Lista processada — \" + $json.resumo.total + \" linhas, \" + $json.resumo.em_revisao + \" em revisão.\" }) }}",
        "options": {}
      },
      "id": "enviarXls",
      "name": "Enviar XLS (privado)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.uazapiUrl }}/send/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $(\"Config\").item.json.uazapiToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $(\"Config\").item.json.adminPrivado, type: \"image\", file: $(\"Baixar mídia\").item.json.fileURL, text: \"Foto original para conferência.\" }) }}",
        "options": {}
      },
      "id": "enviarFoto",
      "name": "Enviar foto original (privado)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1720,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.uazapiUrl }}/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $(\"Config\").item.json.uazapiToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $(\"Config\").item.json.adminPrivado, text: ($json.mensagem_admin || \"Não consegui ler a lista. Reenvie a foto mais nítida, por favor.\") }) }}",
        "options": {}
      },
      "id": "avisarAdmin",
      "name": "Avisar admin (falha)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        320
      ]
    },
    {
      "parameters": {},
      "id": "ignorar",
      "name": "Ignorar (não autorizado)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
